APP_NAME="Clinic App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL: create the database first (e.g. CREATE DATABASE clinic_db;)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# API login tokens expire after this many minutes (720 = 12 hours)
SANCTUM_EXPIRATION_MINUTES=720

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clinic.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Web address of the frontend. It is also the origin allowed to call the API from a browser (CORS).
FRONTEND_URL=http://localhost:5173
# Optional: several allowed origins, comma-separated, no trailing slash. Overrides FRONTEND_URL for CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IPs of the reverse proxy / load balancer whose X-Forwarded-For header may be trusted (comma-separated,
# CIDR ranges allowed). Leave EMPTY for local development: then the visitor's own IP is used and the
# header cannot be faked. See config/trustedproxy.php.
TRUSTED_PROXIES=

# Google sign-in ("Continue with Google") — @urios.edu.ph accounts only.
# Create OAuth credentials in Google Cloud Console; the redirect URI must be
# {APP_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
