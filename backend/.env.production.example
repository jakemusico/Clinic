APP_NAME="FSUU Clinic"
APP_ENV=production
APP_KEY=
# Never true in production: it shows stack traces and slows every request.
APP_DEBUG=false
APP_URL=https://clinic.example.edu.ph
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_db
DB_USERNAME=clinic_app
DB_PASSWORD=change-me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# The dashboards cache their slow-changing numbers for 30-60 s. "file" is fine for one server;
# use "redis" (or "database") when there are several servers.
CACHE_STORE=file

# API login tokens expire after this many minutes (720 = 12 hours)
SANCTUM_EXPIRATION_MINUTES=720

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@clinic.example.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Web address(es) of the frontend that may call the API from a browser (CORS). Comma-separated,
# scheme + host (+ port), NO trailing slash and no path. If it is not set, FRONTEND_URL is used.
# Not needed when the frontend and the API are served from the same address.
FRONTEND_URL=https://clinic.example.edu.ph
CORS_ALLOWED_ORIGINS=https://clinic.example.edu.ph

# IPs of YOUR reverse proxy / load balancer (nginx, Apache, Cloudflare tunnel ...), comma-separated,
# CIDR ranges allowed. Only these may supply X-Forwarded-For, which the audit log records as the
# visitor's IP. nginx/Apache on the same server: 127.0.0.1. Never use "*". See config/trustedproxy.php.
TRUSTED_PROXIES=127.0.0.1
